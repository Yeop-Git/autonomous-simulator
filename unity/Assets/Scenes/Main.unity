--- !u!114 &134888452
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 134888451}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 15c2409ef4c7afa46a8c23ae5b1c44b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::V2X.UI.SceneHubController
  entries:
  - sceneName: LKA_Test
    title: "LKA_Test \xB7 \uCC28\uC120 \uC720\uC9C0 \uC2DC\uD5D8\uB85C"
    summary: "\uC77C\uC815 \uACE1\uB960\uC758 \uB2E8\uC77C \uACE1\uC120 \uD2B8\uB799.
      \uB2E4\uB978 \uCC28\uB7C9\uB3C4 \uC774\uBCA4\uD2B8\uB3C4 \uC5C6\uC774 \uD6A1\uBC29\uD5A5
      \uC81C\uC5B4\uAE30\uB9CC \uD640\uB85C \uB0A8\uACA8 lateral / heading error\uB97C
      \uC77D\uB294\uB2E4."
    techniques: "\xB7 \uD6A1\uBC29\uD5A5 \uC81C\uC5B4: Pure Pursuit / Stanley (\uC52C
      \uAE30\uBCF8\uAC12 Stanley)\n\xB7 Frenet \uC624\uCC28 \uACC4\uC0B0 (lateral
      / heading)\n\xB7 \uC885\uBC29\uD5A5 \uC81C\uC5B4: ACC \uC790\uC720\uC8FC\uD589
      \uAD6C\uAC04\n\xB7 \uACE0\uC815 CSV \uB85C\uAE45 \uC2A4\uD0A4\uB9C8 \u2192
      \uC18D\uB3C4\uBCC4 RMS \uC624\uCC28 \uBE44\uAD50"
    controls: "1\xB72\xB73 \uCE74\uBA54\uB77C \uC804\uD658 / Esc \uD5C8\uBE0C\uB85C"
  - sceneName: Highway
    title: "Highway \xB7 \uACE0\uC18D\uB3C4\uB85C \uD569\uB958\uC640 \uCC28\uC120
      \uBCC0\uACBD"
    summary: "3\uCC28\uC120 \uBCF8\uC120 + \uC628\uB7A8\uD504. \uB7A8\uD504 \uCC28\uB7C9\uC740
      \uBCF8\uC120 \uC911\uAC04(z=115)\uC73C\uB85C \uD569\uB958\uD558\uBBC0\uB85C,
      \uC911\uC559 \uC11C\uBC84\uAC00 \uC2DC\uAC04 \uC2AC\uB86F\uC744 \uC608\uC57D\uD574
      \uB07C\uC6CC \uB123\uB294\uB2E4."
    techniques: "\xB7 V2X \uD569\uB958 \uC608\uC57D: ETA \uAE30\uBC18 \uC2AC\uB86F
      \uD0D0\uC0C9 \u2192 \uB7A8\uD504 \uC7AC\uD0C0\uC774\uBC0D \u2192 \uADF8\uB798\uB3C4
      \uC548 \uB418\uBA74 \uBCF8\uC120 \uCC28\uB7C9\uC5D0 \uC591\uBCF4 \uC9C0\uC2DC\n\xB7
      \uD569\uB958 \uCC28\uC120 \uD310\uC815\uC744 \uC704\uC0C1/\uAE30\uD558\uB85C
      \uB3C4\uCD9C (\uCC28\uC120 \uC774\uB984 \uBB34\uAD00)\n\xB7 \uC911\uAC04 \uD569\uB958
      \uC811\uD569\uC744 \uBC18\uC601\uD55C \uC120\uD589\uCC28 \uD0D0\uC0C9 + ACC\n\xB7
      \uCC28\uC120 \uBCC0\uACBD \uAC2D \uC218\uC6A9 \uD310\uC815 (lead/lag \uC2DC\uAC04
      \uAC04\uACA9)\n\xB7 A* \uC804\uC5ED \uACBD\uB85C + \uB099\uD558\uBB3C \uC774\uBCA4\uD2B8
      \uC7AC\uACC4\uD68D"
    controls: "Q/E \uCC28\uC120 \uBCC0\uACBD
      \xB7 1\xB72\xB73 \uCE74\uBA54\uB77C / Esc \uD5C8\uBE0C\uB85C"
  - sceneName: Urban
    title: "Urban \xB7 \uC2E0\uD638 \uAD50\uCC28\uB85C\uC640 \uBCF4\uD638 \uC88C\uD68C\uC804"
    summary: "4\uBC29\uD5A5 8\uC811\uADFC\uB85C \uC2E0\uD638 \uAD50\uCC28\uB85C.
      \uC9C1\uC9C4\xB7\uC88C\uD68C\uC804\xB7\uC6B0\uD68C\uC804\uC744 UI\uB85C \uACE0\uB974\uBA74
      \uC11C\uBC84\uAC00 \uC2E0\uD638\xB7\uAC2D\xB7\uBCF4\uD589\uC790\uB97C \uBAA8\uB450
      \uD655\uC778\uD558\uACE0 \uBA85\uB839\uD55C\uB2E4."
    techniques: "\xB7 \uACE0\uC815 \uC8FC\uAE30 \uC2E0\uD638 (60 s, \uBCF4\uD589
      \uD398\uC774\uC988 \uD3EC\uD568) \u2014 \uC11C\uBC84\uAC00 \uC9D1\uD589\n\xB7
      \uBCF4\uD638 \uC88C\uD68C\uC804 \uC815\uCC45: \uCC28\uC120 \uBCC0\uACBD \u2192
      \uC815\uC9C0\uC120 \u2192 \uD654\uC0B4\uD45C \u2192 \uAD50\uCC28 \u2192 \uC815\uB82C,\n 
      \uB9E4 \uD2F1 \uC7AC\uD3C9\uAC00\uD558\uBA70 \uB2A6\uC740 \uAC2D \uC2E4\uD328
      \uC2DC \uC9C1\uC9C4\uC73C\uB85C \uC548\uC804 \uCDE8\uC18C\n\xB7 \uD55C\uAD6D\uC2DD
      \uC6B0\uD68C\uC804: \uC801\uC2E0\uD638 \uC644\uC804 \uC815\uC9C0 \uD6C4 \uBCF4\uD589\uC790/\uAD50\uD1B5
      \uC591\uBCF4\uD558\uBA70 \uC9C4\uD589\n\xB7 \uBCF4\uD589\uC790 \uD6A1\uB2E8
      \uC608\uCE21 \uBC0F \uD68C\uC804 \uC8FC\uD589 \uD1B5\uB85C \uCE68\uBC94 \uD310\uC815\n\xB7
      \uAD50\uCC28\uB85C \uCDA9\uB3CC \uC608\uC57D + \uC2E0\uD638\uB85C \uAD00\uB9AC\uB418\uB294
      \uCDA9\uB3CC \uD544\uD130\uB9C1"
    controls: "\uC9C1\uC9C4/\uC88C\uD68C\uC804/\uC6B0\uD68C\uC804 \uD1A0\uAE00 \xB7
      1\xB72\xB73 \uCE74\uBA54\uB77C / Esc \uD5C8\uBE0C\uB85C"
  - sceneName: EmergencyAvoidance
    title: "EmergencyAvoidance \xB7 \uB3CC\uBC1C \uC7A5\uC560\uBB3C\uACFC \uAE34\uAE09\uCC28
      \uD68C\uD53C"
    summary: "\uC9C1\uC120 4\uCC28\uC120 \uC2E4\uD5D8\uB85C. \uC8FC\uD589 \uC911
      \uB099\uD558\uBB3C\uC774 \uB5A8\uC5B4\uC9C0\uACE0 \uB4A4\uC5D0\uC11C \uAE34\uAE09\uCC28\uAC00
      \uC811\uADFC\uD55C\uB2E4. \uC804\uC5ED A* \uB300\uC2E0 \uAD6D\uBD80 \uC0D8\uD50C\uB9C1
      \uD50C\uB798\uB108\uAC00 \uC77C\uC2DC\uC801\uC73C\uB85C \uACBD\uB85C\uB97C
      \uB118\uACA8\uBC1B\uB294\uB2E4."
    techniques: "\xB7 \uCF54\uB9AC\uB3C4 \uC81C\uD55C RRT / RRT* \uAD6D\uBD80 \uD68C\uD53C
      (\uC52C\uC5D0\uC11C \uC2E4\uC2DC\uAC04 \uC804\uD658)\n\xB7 \uD68C\uD53C \uC0C1\uD0DC\uAE30:
      \uAC10\uC9C0 \u2192 \uACC4\uD68D \u2192 \uD6A1\uBC29\uD5A5 \uC774\uD0C8 \u2192
      \uBCF5\uADC0 \uACC4\uD68D \u2192 \uD569\uB958\n\xB7 \uACBD\uB85C \uD6C4\uCC98\uB9AC:
      \uB2E8\uCD95(shortcut) + \uC7AC\uC0D8\uD50C\uB9C1 + \uCD5C\uB300 \uC870\uD5A5\uAC01
      \uAC80\uC99D\n\xB7 \uAE34\uAE09\uCC28 \uC6B0\uC120: \uCD5C\uC6B0\uCE21 \uAC13\uAE38\uB85C
      \uB300\uD53C \uD6C4 \uD1B5\uACFC \uD655\uC778 \uB4A4 \uBCF5\uADC0\n\xB7 \uACC4\uD68D
      \uC2DC\uAC04 / \uCD5C\uC18C \uC5EC\uC720\uAC70\uB9AC \uC2E4\uC2DC\uAC04 \uACC4\uCE21"
    controls: "4 \uB099\uD558\uBB3C \xB7 5 \uAE34\uAE09\uCC28 \xB7 6 RRT\u2194RRT*
      \xB7 0 \uB9AC\uC14B / Esc \uD5C8\uBE0C\uB85C"
  - sceneName: IntegratedCity
    title: "IntegratedCity \xB7 \uD1B5\uD569 10\uBD84 \uC2DC\uB098\uB9AC\uC624"
    summary: "\uAD50\uCC28\uB85C \u2192 \uB300\uB85C \u2192 \uC21C\uD658\uB85C\uB85C
      \uC774\uC5B4\uC9C0\uB294 \uD1B5\uD569 \uCF54\uC2A4. \uC704 \uC52C\uB4E4\uC758
      \uC694\uC18C\uAC00 \uD55C \uC8FC\uD589\uC5D0 \uBAA8\uB450 \uB4F1\uC7A5\uD55C\uB2E4."
    techniques: "\xB7 \uC55E\uC758 \uBAA8\uB4E0 \uC694\uC18C + \uAC13\uAE38\u2194\uB300\uB85C
      \uD14C\uC774\uD37C \uD569\uB958\n\xB7 \uC774\uB984\uC774 \uC544\uB2CC \uC704\uC0C1\uC73C\uB85C
      \uD569\uB958 \uC9C0\uC810\uC744 \uCC3E\uC544 \uC608\uC57D \uC801\uC6A9\n\xB7
      \uC11C\uB85C \uB2E4\uB978 \uB3C4\uB85C \uACC4\uC5F4(\uB3C4\uC2EC/\uAC04\uC120)\uC744
      \uAC00\uB85C\uC9C0\uB974\uB294 \uD68C\uD53C \uCF54\uB9AC\uB3C4\n\xB7 \uB2E4\uCC28\uB7C9
      \uB3D9\uC2DC \uC8FC\uD589 \uC911 \uC804\uC5ED \uC0C1\uD669 \uC778\uC9C0 \uBC0F
      \uCDA9\uB3CC \uC608\uCE21"
    controls: "\uC2DC\uB098\uB9AC\uC624 \uB514\uB809\uD130\uAC00 \uC774\uBCA4\uD2B8\uB97C
      \uC790\uB3D9 \uC9C4\uD589 \xB7 1\xB72\xB73 \uCE74\uBA54\uB77C / Esc \uD5C8\uBE0C\uB85C"
