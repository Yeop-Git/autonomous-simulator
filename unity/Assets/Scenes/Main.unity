--- !u!114 &143636184
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 143636183}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 15c2409ef4c7afa46a8c23ae5b1c44b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::V2X.UI.SceneHubController
  entries:
  - sceneName: LKA_Test
    title: "LKA_Test \xB7 \uCC28\uC120 \uC720\uC9C0 \uC2DC\uD5D8\uB85C"
    summary: "\uAD6C\uC131: \uBC18\uACBD 90 m \uB2E8\uC77C \uACE1\uC120 \uD2B8\uB799,
      \uCC28\uB7C9 1\uB300, \uAD50\uD1B5\xB7\uC774\uBCA4\uD2B8 \uC5C6\uC74C.\n\uBAA9\uC801:
      \uB2E4\uB978 \uC694\uC778\uC744 \uBAA8\uB450 \uC81C\uAC70\uD558\uACE0 \uD6A1\uBC29\uD5A5
      \uC81C\uC5B4\uAE30\uB9CC \uACA9\uB9AC \uACC4\uCE21."
    techniques: "\xB7 \uD6A1\uBC29\uD5A5 \uC81C\uC5B4: Pure Pursuit / Stanley \u2014
      \uC52C \uAE30\uBCF8\uAC12 Stanley\n  (\uBBF8\uC870\uC815 \uAE30\uBCF8 \uC774\uB4DD:
      Stanley k=1.5, \uCD5C\uB300 \uC870\uD5A5 0.6 rad)\n\xB7 \uC885\uBC29\uD5A5
      \uC81C\uC5B4: ACC \uC790\uC720\uC8FC\uD589 \uAD6C\uAC04 (\uC120\uD589\uCC28
      \uC5C6\uC74C)\n\xB7 \uACC4\uCE21: Frenet \uC624\uCC28 \u2014 \uD6A1\uC624\uCC28
      \xB7 \uD5E4\uB529\uC624\uCC28 \xB7 Menger \uACE1\uB960\n\xB7 \uB85C\uAE45:
      \uACE0\uC815 CSV \uC2A4\uD0A4\uB9C8 \u2192 \uC18D\uB3C4\uBCC4 RMS \uD6A1\uC624\uCC28\n\xB7
      \uBCC4\uB3C4 \uADFC\uAC70: Python \uD569\uC131 \uD2B8\uB799(R=140 m) \uB2E8\uC77C
      \uC2A4\uC715 \u2014 \uC774 \uC52C\uC758\n  R=90 m Unity \uC52C \uAD6C\uC131\uACFC
      \uD63C\uB3D9\uD558\uC9C0 \uC54A\uC74C (README \xA711.2)"
    controls: "1\xB72\xB73 \uCE74\uBA54\uB77C \uC804\uD658 / Esc \uD5C8\uBE0C\uB85C"
  - sceneName: Highway
    title: "Highway \xB7 \uACE0\uC18D\uB3C4\uB85C \uD569\uB958\uC640 \uCC28\uC120
      \uBCC0\uACBD"
    summary: "\uAD6C\uC131: 3\uCC28\uC120 \uBCF8\uC120 300 m(27.8 m/s) + \uC628\uB7A8\uD504(18
      m/s).\n\uC7C1\uC810: \uB7A8\uD504\uAC00 \uBCF8\uC120 \uB05D\uC774 \uC544\uB2CC
      \uC911\uAC04 z=115 m\uB85C \uC811\uD569\uD55C\uB2E4."
    techniques: "\xB7 \uD569\uB958 \uC608\uC57D: \uBCF8\uC120 ETA \uC815\uB82C \u2192
      2.0 s \uAC2D \uD0D0\uC0C9 \u2192 \uB7A8\uD504 \uC7AC\uD0C0\uC774\uBC0D\n  \u2192
      \uAC2D\uC774 \uC5C6\uC73C\uBA74 \uBCF8\uC120 \uCC28\uB7C9\uC5D0 \uAC10\uC18D\uC744
      \uC9C0\uC2DC\uD574 \uAC2D\uC744 \uC5F0\uB2E4\n  (\uB7A8\uD504 \uCC28\uB7C9
      \uD63C\uC790\uC11C\uB294 \uBD88\uAC00\uB2A5\uD55C \uC218 \u2014 \uC911\uC559
      \uAD00\uC81C\uC758 \uD575\uC2EC)\n\xB7 \uD310\uC815: \uD569\uB958 \uCC28\uC120\uC744
      \uC774\uB984\uC774 \uC544\uB2CC \uC704\uC0C1\xB7\uAE30\uD558\uB85C \uB3C4\uCD9C\n\xB7
      \uCD94\uC885: \uC911\uAC04 \uC811\uD569\uC744 \uBC18\uC601\uD55C \uC120\uD589\uCC28
      \uD0D0\uC0C9(\uD558\uB958\xB7\uD615\uC81C \uCC28\uC120) + ACC\n\xB7 \uCC28\uC120
      \uBCC0\uACBD: lead/lag \uC2DC\uAC04 \uAC04\uACA9 1.5 s \uAC2D \uC218\uC6A9\n\xB7
      \uC804\uC5ED \uACBD\uB85C: A* + \uC911\uAC04 \uD569\uB958 \uC811\uD569 \uCC98\uB9AC"
    controls: "Q/E \uCC28\uC120 \uBCC0\uACBD \xB7 1\xB72\xB73 \uCE74\uBA54\uB77C
      / Esc \uD5C8\uBE0C\uB85C"
  - sceneName: Urban
    title: "Urban \xB7 \uC2E0\uD638 \uAD50\uCC28\uB85C\uC640 \uBCF4\uD638 \uC88C\uD68C\uC804"
    summary: "\uAD6C\uC131: 4\uBC29\uD5A5 8\uC811\uADFC\uB85C \uC2E0\uD638 \uAD50\uCC28\uB85C,
      \uC815\uC9C0\uC120\uC740 \uC911\uC2EC\uC5D0\uC11C 16 m.\n\uB3D9\uC791: \uC9C1\uC9C4\xB7\uC88C\uD68C\uC804\xB7\uC6B0\uD68C\uC804\uC744
      UI\uB85C \uC9C0\uC815\uD558\uBA74 \uC11C\uBC84\uAC00 \uD310\uB2E8\uD55C\uB2E4."
    techniques: "\xB7 \uC2E0\uD638: 60 s \uACE0\uC815 \uC8FC\uAE30 \u2014 \uC11C\uBC84\uAC00
      \uC9D1\uD589\uD558\uACE0 Unity\uB294 \uADF8\uB9B0\uB2E4\n  \uB3D9\uC11C\uB179
      10 \u2192 \uBCF4\uD589 8 \u2192 \uB0A8\uBD81\uB179 10 \u2192 \uC88C\uD68C\uC804
      6 \u2192 \uBCF4\uD589 8 s\n  + \uD669\uC0C9\xB7\uC804\uC801\uC0C9 \uBC84\uD37C
      18 s (\uC804\uCCB4 60 s, \uC0C1\uC138 README \xA77.3)\n  \uC815\uC9C0\uC120
      5.5 m \uC804, 1.8 m/s\xB2\uC758 \uD3B8\uC548\uD55C \uAC10\uC18D\uC73C\uB85C
      \uC120\uD589 \uC81C\uB3D9\n\xB7 \uC88C\uD68C\uC804: \uAC2D 1.25 s \uC218\uC6A9
      \u2192 \uC815\uC9C0\uC120 14 m \uC804 \uCC28\uC120 \uBCC0\uACBD \uC644\uB8CC\n 
      \u2192 \uD654\uC0B4\uD45C \uB300\uAE30 \u2192 \uAD50\uCC28. \uB9E4 \uD2F1 \uC7AC\uD3C9\uAC00,
      \uC2E4\uD328 \uC2DC \uC9C1\uC9C4 \uCDE8\uC18C\n  \uC88C\uD68C\uC804 \uC911
      \uBCF4\uD589\uC790\uB9CC \uD1B5\uB85C(\uBC18\uD3ED 3 m) \uD22C\uC601\uC73C\uB85C
      \uD310\uC815 \u2014 \uC778\uB3C4\uC758\n  \uC0AC\uB78C\uC740 \uBB34\uC2DC.
      \uADF8 \uC678 \uCDA9\uB3CC\uC740 \uBC18\uACBD 2.5 m \uC6D0\uD615 \uD310\uC815\uC774\uB2E4\n\xB7
      \uCDA9\uB3CC: \uC2E0\uD638\uB85C \uAD00\uB9AC\uB418\uB294 \uCDA9\uB3CC\uC740
      \uC81C\uC678 \u2014 \uB179\uC0C9\uC774 \uC801\uC0C9\uC5D0 \uC81C\uB3D9\uD558\uC9C0
      \uC54A\uAC8C"
    controls: "\uC9C1\uC9C4/\uC88C\uD68C\uC804/\uC6B0\uD68C\uC804 \uD1A0\uAE00 \xB7
      1\xB72\xB73 \uCE74\uBA54\uB77C / Esc \uD5C8\uBE0C\uB85C"
  - sceneName: EmergencyAvoidance
    title: "EmergencyAvoidance \xB7 \uB3CC\uBC1C \uC7A5\uC560\uBB3C\uACFC \uAE34\uAE09\uCC28
      \uD68C\uD53C"
    summary: "\uAD6C\uC131: \uC9C1\uC120 4\uCC28\uC120 \uC2E4\uD5D8\uB85C(\uC8FC\uD589
      3 + \uAC13\uAE38 1). \uB099\uD558\uBB3C\uC774 \uB5A8\uC5B4\uC9C0\uACE0 \uB4A4\uC5D0\uC11C
      \uAE34\uAE09\uCC28\uAC00 \uC811\uADFC\uD55C\uB2E4.\n\uC7C1\uC810: \uAD6D\uBD80
      \uC0D8\uD50C\uB9C1 \uD50C\uB798\uB108\uB97C \uC218\uB3D9 \uC804\uD658\uD574
      \uBE44\uAD50\uD558\uB294 \uC804\uC6A9 \uC2E4\uD5D8\uB85C."
    techniques: "\xB7 \uAD6D\uBD80 \uACC4\uD68D: \uCF54\uB9AC\uB3C4 \uC81C\uD55C
      RRT / RRT* \u2014 \uC2E4\uD589 \uC911 \uC804\uD658 \uAC00\uB2A5\n  \uD0D0\uC0C9
      \uACF5\uAC04 = \uC778\uC811 \uCC28\uC120\uAD70 + \uD6C4\uC18D \uCC28\uC120.
      \uD0C0 \uCC28\uB7C9\uC740 3 s \uC608\uCE21\uC744\n  \uBC18\uACBD 2.45 m\uB85C,
      \uC7A5\uC560\uBB3C\uC740 \uC790\uAE30 \uBC18\uACBD + 1.45 m\uB85C \uBD80\uD480\uB9B0\uB2E4\n 
      \uC911\uB2E8 \uD55C\uACC4 RRT 45 ms / RRT* 140 ms \u2014 40 ms \uC1A1\uC2E0
      \uAC04\uACA9\uBCF4\uB2E4 \uAE38 \uC218 \uC788\uC74C\n  RRT* \uC804\uD658\uC740
      \uBE44\uAD50\uC6A9\uC774\uBA70 25 Hz \uC6B4\uC6A9 \uAE30\uBCF8\uAC12\uC740
      RRT\n\xB7 \uD6C4\uCC98\uB9AC: \uB2E8\uCD95(0.5 m) \u2192 \uC7AC\uC0D8\uD50C\uB9C1(2
      m) \u2192 \uAEBE\uC784\uAC01 78\xB0 \uCD08\uACFC \uC2DC \uD3D0\uAE30\n\xB7
      \uC0C1\uD0DC\uAE30: \uAC10\uC9C0 \u2192 \uD0C8\uCD9C\uACC4\uD68D \u2192 \uD6A1\uBC29\uD5A5
      \uC774\uD0C8 \u2192 \uBCF5\uADC0\uACC4\uD68D \u2192 \uC6D0\uCC28\uC120 \uD569\uB958\n 
      \uBCF5\uADC0\uAC00 \uB9C9\uD788\uBA74 \uC815\uC9C0 \uB300\uC2E0 \uD68C\uD53C
      \uCC28\uC120 \uC8FC\uD589 \uD6C4 1.5 s \uB4A4 \uC7AC\uC2DC\uB3C4\n\xB7 \uAE34\uAE09\uCC28:
      \uBC18\uACBD 60 m\uC5D0\uC11C \uCD5C\uC6B0\uCE21 \uAC13\uAE38 \uB300\uD53C,
      \uD1B5\uACFC \uD655\uC778 \uD6C4 \uBCF5\uADC0\n\xB7 \uACC4\uCE21: \uACC4\uD68D
      \uC2DC\uAC04 / \uCD5C\uC18C \uC5EC\uC720\uAC70\uB9AC\uB97C \uBA85\uB839\uC5D0
      \uC2E4\uC5B4 \uC2E4\uC2DC\uAC04 \uBCF4\uACE0"
    controls: "4 \uB099\uD558\uBB3C \xB7 5 \uAE34\uAE09\uCC28 \xB7 6 RRT\u2194RRT*
      \xB7 0 \uB9AC\uC14B / Esc \uD5C8\uBE0C\uB85C"
  - sceneName: IntegratedCity
    title: "IntegratedCity \xB7 \uD1B5\uD569 \uC2DC\uB098\uB9AC\uC624"
    summary: "\uAD6C\uC131: \uAD50\uCC28\uB85C \u2192 \uB300\uB85C \u2192 \uC21C\uD658\uB85C.
      \uB3C4\uC2EC \uC2E0\uD638, \uAC13\uAE38 \uD14C\uC774\uD37C, \uC7A5\uC560\uBB3C\xB7\uAE34\uAE09\uCC28
      \uC774\uBCA4\uD2B8\uB97C \uC120\uD0DD\uC801\uC73C\uB85C \uD1B5\uD569\uD55C\uB2E4.\n\uC7C1\uC810:
      \uB3C4\uC2EC \uACA9\uC790(urban_*)\uC640 \uAC04\uC120(city_*), \uBA85\uBA85
      \uADDC\uCE59\uC774 \uB2E4\uB978 \uB450 \uACC4\uC5F4\uC758 \uACF5\uC874."
    techniques: "\xB7 \uD569\uB958: \uAC13\uAE38\u2194\uB300\uB85C \uD14C\uC774\uD37C
      \u2014 \uC811\uD569 15 m \uC804 \uB098\uB780\uD788 \uB2EC\uB9AC\uB294 \uB354
      \uB290\uB9B0\n  \uCC28\uC120\uC73C\uB85C \uD310\uC815. \uCC28\uC120 \uC774\uB984\uC774
      \uC544\uB2C8\uB77C \uC704\uC0C1\xB7\uAE30\uD558\uAC00 \uADFC\uAC70\uB2E4\n\xB7
      \uD68C\uD53C: \uC11C\uB85C \uB2E4\uB978 \uB3C4\uB85C \uACC4\uC5F4\uC744 \uAC00\uB85C\uC9C0\uB974\uB294
      \uCF54\uB9AC\uB3C4 \uAD6C\uC131\n\xB7 \uC778\uC9C0: \uB2E4\uCC28\uB7C9 \uB3D9\uC2DC
      \uC8FC\uD589 \uC911 \uC804\uC5ED \uC0C1\uD669 \uC778\uC9C0\uC640 \uD574\uC11D\uC801
      \uCDA9\uB3CC \uC608\uCE21\n  (\uC9C0\uD3C9\uC120 4 s, \uC548\uC804\uAC70\uB9AC
      2.5 m, \uC0D8\uD50C \uC0AC\uC774 \uD130\uB110\uB9C1 \uC5C6\uC74C)\n\xB7 \uBD80\uD558:
      3\uB300 50 s \uD5E4\uB4DC\uB9AC\uC2A4 \uB2E8\uC77C \uC2E4\uD589\uC5D0\uC11C
      Python step()\n  p50 0.74 ms / p95 1.40 ms \u2014 \uB124\uD2B8\uC6CC\uD06C\xB7Unity
      \uC801\uC6A9 \uC2DC\uAC04 \uC81C\uC678"
    controls: "\uC2DC\uB098\uB9AC\uC624 \uB514\uB809\uD130\uAC00 \uC774\uBCA4\uD2B8\uB97C
      \uC790\uB3D9 \uC9C4\uD589 \xB7 1\xB72\xB73 \uCE74\uBA54\uB77C / Esc \uD5C8\uBE0C\uB85C"
